rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The website accesses Firestore through authenticated Next.js server actions.
    // Direct browser access is intentionally disabled; Admin SDK authorization is
    // enforced by the server session and staff-email allowlist.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
